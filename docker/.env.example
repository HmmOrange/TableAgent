# Host port for direct access. AXIOM uses http://table-agent:3636 internally.
TABLE_AGENT_HOST_PORT=3636

# Answer model exposed through an OpenAI-compatible API.
TABLE_AGENT_LLM_BASE_URL=http://host.docker.internal:8010/v1
TABLE_AGENT_LLM_MODEL=your-answer-model
TABLE_AGENT_LLM_API_KEY=EMPTY

# Vision/layout model exposed through an OpenAI-compatible API.
TABLE_AGENT_VLM_BASE_URL=http://host.docker.internal:8010/v1
TABLE_AGENT_VLM_MODEL=your-vision-model
TABLE_AGENT_VLM_API_KEY=EMPTY

# Optional embedding model used when retrieval-card embeddings are requested.
TABLE_AGENT_EMBEDDING_BASE_URL=http://host.docker.internal:8001/v1
TABLE_AGENT_EMBEDDING_MODEL=BAAI/bge-m3
TABLE_AGENT_EMBEDDING_API_KEY=EMPTY
TABLE_AGENT_EMBEDDING_TIMEOUT_SECONDS=120

# Optional API authentication shared with AXIOM.
TABLE_AGENT_SERVICE_API_KEY=
